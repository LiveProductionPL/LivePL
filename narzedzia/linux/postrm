#!/bin/sh
# LivePL: po usunięciu pakietu .deb (dane użytkownika w ~/.config/LivePL zostają)
set -e
if [ "$1" = "remove" ] || [ "$1" = "purge" ]; then
  if [ -e /etc/apparmor.d/livepl ]; then
    apparmor_parser --remove /etc/apparmor.d/livepl 2>/dev/null || true
    rm -f /etc/apparmor.d/livepl
  fi
  command -v update-desktop-database >/dev/null 2>&1 && update-desktop-database -q /usr/share/applications || true
  command -v update-mime-database >/dev/null 2>&1 && update-mime-database /usr/share/mime || true
fi
exit 0
