<?xml version="1.0" encoding="utf-8"?>
<!-- TVML: serwis informacyjny tvml.pl. Bez śledzenia i bez identyfikatora reklamowego; powiadomienia przez
     Firebase Cloud Messaging bez Firebase Analytics (Powiadomienia.kt). -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+: zgoda na powiadomienia; aplikacja pyta dopiero po włączeniu w Więcej → Powiadomienia -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- karta przeglądarki dla stron tvml.pl (Custom Tabs) -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.TVML">

        <!-- powiadomienia FCM: usługa (token i wiadomości przy otwartej aplikacji) oraz wygląd tych,
             które system pokazuje sam, gdy aplikacja jest w tle -->
        <service
            android:name=".UslugaPowiadomien"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="nowe_wpisy" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ikona_powiadomienia" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/granat" />
        <!-- bez Analytics i bez zbierania danych o dostarczeniu do BigQuery -->
        <meta-data
            android:name="firebase_analytics_collection_deactivated"
            android:value="true" />
        <meta-data
            android:name="delivery_metrics_exported_to_big_query_enabled"
            android:value="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation|uiMode|density"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.TVML.Start">
            <!-- linki do artykułów otwierają się w aplikacji, gdy tvml.pl poda assetlinks.json dla tego pakietu -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:host="tvml.pl" />
                <data android:host="www.tvml.pl" />
                <data android:pathPrefix="/artykul/" />
            </intent-filter>
        </activity>

        <!-- Trzy ikony wbudowane w aplikację: panel tvml.pl wybiera je przez wersję wyglądu (theme.appIcon).
             Włączona jest zawsze dokładnie jedna (IkonaAplikacji.kt). -->
        <activity-alias
            android:name=".IkonaZwykla"
            android:enabled="true"
            android:exported="true"
            android:icon="@mipmap/ic_launcher"
            android:roundIcon="@mipmap/ic_launcher"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IkonaZima"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_zima"
            android:roundIcon="@mipmap/ic_launcher_zima"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
        <activity-alias
            android:name=".IkonaSwieta"
            android:enabled="false"
            android:exported="true"
            android:icon="@mipmap/ic_launcher_swieta"
            android:roundIcon="@mipmap/ic_launcher_swieta"
            android:targetActivity=".MainActivity">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity-alias>
    </application>
</manifest>
