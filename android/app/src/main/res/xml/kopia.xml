<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: do kopii zapasowej i na nowy telefon idą tylko ustawienia LivePL (Moje strony, tryb),
     bez ciasteczek, logowań i otwartych kart. -->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="livepl.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="sharedpref" path="livepl.xml" />
    </device-transfer>
</data-extraction-rules>
